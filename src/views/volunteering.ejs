<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>

    <section class="volunteered-projects-section" style="margin-top: 1.5rem;">
        <h2>Projects You Have Volunteered For</h2>
        <% if (typeof volunteeredProjects !== 'undefined' && volunteeredProjects.length > 0) { %>
            <ul style="list-style-type: none; padding-left: 0;">
                <% volunteeredProjects.forEach(project => { %>
                    <li style="margin-bottom: 0.75rem; padding: 0.75rem; border: 1px solid #e0e0e0; border-radius: 6px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem;">
                        <div>
                            <a href="/project/<%= project.project_id %>"><strong><%= project.title %></strong></a>
                            <% if (project.project_date) { %>
                                <span style="color: #555; font-size: 0.9rem;"> &ndash; <%= project.project_date %></span>
                            <% } %>
                            <% if (project.location) { %>
                                <span style="color: #555; font-size: 0.9rem;"> (<%= project.location %>)</span>
                            <% } %>
                        </div>
                        <a href="/project/<%= project.project_id %>/unvolunteer" class="btn btn-danger" style="color: #dc3545; text-decoration: underline; font-size: 0.9rem;">Remove volunteer status</a>
                    </li>
                <% }); %>
            </ul>
        <% } else { %>
            <p>You haven't volunteered for any projects yet. Check out <a href="/projects">upcoming service projects</a>!</p>
        <% } %>
    </section>

</main>

<%- include('partials/footer') %>
