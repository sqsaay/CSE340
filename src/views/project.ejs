<%- include('partials/header') %>
    <main>
        <h1>
            <%= title %>
        </h1>
        <% if (user && user.role_name === 'admin') { %>
        <div class="page-actions">
            <a href="/edit-project/<%= project.project_id %>">Edit Project</a>
        </div>
        <% } %>
        <p><strong>Description:</strong>
            <%= project.description %>
        </p>
        <p><strong>Date:</strong>
            <%= project.date %>
        </p>
        <p><strong>Location:</strong>
            <%= project.location %>
        </p>
        <p><strong>Organization:</strong> <a href="/organization/<%= project.organization_id %>">
                <%= project.organization_name %>
            </a></p>
        <% if (categories && categories.length> 0) { %>
            <p><strong>Categories:</strong></p>
            <ul class="category-tags">
                <% categories.forEach(category=> { %>
                    <li>
                        <a href="/category/<%= category.category_id %>">
                            <%= category.name %>
                        </a>
                    </li>
                    <% }); %>
            </ul>
            <% } %>

        <% if (isLoggedIn) { %>
        <div class="volunteer-section" style="margin: 1.5rem 0; padding: 1rem; border: 1px solid #ccc; border-radius: 8px;">
            <h3>Volunteering</h3>
            <% if (isVolunteered) { %>
                <p style="color: green; font-weight: bold; font-size: 1.1rem;">You are volunteering for this project</p>
                <p><a href="/project/<%= project.project_id %>/unvolunteer" class="btn btn-danger" style="color: #dc3545; text-decoration: underline;">Remove yourself as a volunteer</a></p>
            <% } else { %>
                <p><a href="/project/<%= project.project_id %>/volunteer" class="btn btn-primary" style="display: inline-block; padding: 0.5rem 1rem; background-color: #007bff; color: white; text-decoration: none; border-radius: 4px;">Volunteer for this project</a></p>
            <% } %>

            <% if (typeof volunteers !== 'undefined' && volunteers.length > 0) { %>
                <h4 style="margin-top: 1rem;">Current Volunteers (<%= volunteers.length %>):</h4>
                <ul>
                    <% volunteers.forEach(v => { %>
                        <li><%= v.name %></li>
                    <% }); %>
                </ul>
            <% } %>
        </div>
        <% } %>

        <div class="page-actions">
            <% if (user && user.role_name === 'admin') { %>
                <a href="/project/<%= project.project_id %>/assign-categories">Edit Categories</a>
            <% } %>
            <a href="/projects">Back to project list</a>
        </div>
                
    </main>
    <%- include('partials/footer') %>